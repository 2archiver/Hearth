# Android / Gradle build output
*.iml
.gradle/
.toolchains/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_

# Android Studio
*.iws
*.ipr
out/

# Gradle wrapper — JAR must be committed so ./gradlew works after clone
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Private signing keys — NEVER commit these (use secrets/keystore.properties instead)
*.jks
*.keystore
keystore.properties
release.properties
release.env
.release.env

# EXCEPTION: app/signing/phairplay.p12 is a PUBLIC "community build" key, committed on
# purpose so every CI run and every local build signs identically and installing a new
# APK updates the old one instead of failing with "package conflicts with an existing
# package". It is not a secret. To use your own private key instead, see docs/RELEASING.md.

# Local configuration files
local.defaults.properties

# Generated files (the Cast bridge's TLS keystore below is a committed source file)
app/src/main/assets/*
!app/src/main/assets/castv2-server.p12

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Test results
test-results/
lint-results/
device-test-logs/

# Profiling
*.hprof
