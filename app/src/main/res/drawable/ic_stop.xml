<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_stop.xml — "Stop casting" control glyph (Home control row).

    WHY THIS IS A VECTOR AND NOT A SHAPE: until 2.1.0 this file was a full-bleed solid
    rectangle with no inset, so the ImageButton between Start and Stop receiver rendered as an
    unexplained solid brown square. A control affordance must look like a control: a rounded
    square stop mark inset inside the 24dp icon box, drawn in the same palette as the disabled
    "Stop receiver" label.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@color/status_stopped"
        android:pathData="M8,6h8a2,2 0 0 1 2,2v8a2,2 0 0 1 -2,2H8a2,2 0 0 1 -2,-2V8a2,2 0 0 1 2,-2z" />
</vector>
