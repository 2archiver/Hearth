<?xml version="1.0" encoding="utf-8"?>
<!--
    focus_ring_selector.xml — Focus state drawable for all interactive TV elements.
    Modern Material 3 TV style: subtle surface with a soft blue glow on focus.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state: bright blue ring with elevation glow and brightened surface -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft glow shadow for elevated look -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_glow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Surface background -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/background_surface_high" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Accent border ring -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/focus_ring" />
                    <corners android:radius="16dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed state: slightly dimmed accent -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_surface_elevated" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Normal state: subtle surface card with slight rounding -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>
