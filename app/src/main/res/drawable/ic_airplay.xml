<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_airplay.xml — AirPlay protocol icon (Material-style "airplay" glyph).
    Outline of a TV/display with an upward chevron inside, tinted AirPlay blue.
    Using stroke paths instead of a filled rounded rectangle, so it looks like
    an icon rather than a flat colored square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Display bezel (outline) -->
    <path
        android:fillColor="@color/protocol_airplay"
        android:pathData="M20,3H4C2.89,3 2.01,3.89 2.01,5L2,17c0,1.1 0.89,2 2,2h6l-2,2v1h12v-1l-2,-2h6c1.1,0 2,-0.9 2,-2V5C22,3.89 21.1,3 20,3zM20,17H4V5h16V17z" />
    <!-- Up-chevron inside display (the AirPlay "send up" triangle) -->
    <path
        android:fillColor="@color/protocol_airplay"
        android:pathData="M12,8l-4,4h3v3h2v-3h3L12,8z" />
</vector>
