<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug HUD plate: translucent black with a soft corner radius, so monospace text stays legible
    over bright video without hiding it. Kept dark on purpose — the wine/pink identity belongs to
    the app chrome, not to a diagnostic readout.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#D2100A0E" />
    <stroke android:width="1dp" android:color="#662A1D24" />
    <corners android:radius="10dp" />
</shape>
