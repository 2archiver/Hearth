<?xml version="1.0" encoding="utf-8"?>
<!--
    card_protocol_status.xml — Reusable status card for one protocol (AirPlay/Miracast/Cast).
    Modern Material 3 card design: generous padding, clean typography hierarchy,
    subtle surface with focus glow.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/focus_ring_selector"
    android:focusable="true">

    <!-- Protocol icon (set programmatically in HomeFragment) -->
    <ImageView
        android:id="@+id/img_protocol_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_airplay"
        android:importantForAccessibility="no" />

    <!-- Protocol name: "AirPlay", "Miracast", "Cast" -->
    <TextView
        android:id="@+id/text_protocol_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.0"
        android:layout_marginBottom="12dp" />

    <!-- Status row: dot + state label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <View
            android:id="@+id/dot_protocol_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_protocol_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!--
        Detail line: sender name when connected, hint when idle, or error message on failure.
        NO ellipsis ("…") — users report error/status text is truncated. Allow up to 4 lines so
        long messages (e.g. "Missing Cast App ID · set PHAIRPLAY_CAST_APP_ID in gradle.properties")
        are fully readable on the Google TV launcher card.
    -->
    <TextView
        android:id="@+id/text_protocol_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp"
        android:maxLines="4"
        android:ellipsize="none"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
