<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme — dark TV theme based on Google TV Streamer design language.
        - True black background for OLED-friendly displays
        - Accent blue for focus and active states
        - Leanback parent for D-pad / TV launcher compatibility
    -->
    <style name="Theme.PhairPlay" parent="@style/Theme.AppCompat.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/accent_blue</item>
        <item name="android:colorPrimaryDark">@color/background_dark</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- Fullscreen theme: hides status bar for StreamingScreen -->
    <style name="Theme.PhairPlay.Fullscreen" parent="Theme.PhairPlay">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Hearth.Control" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item><item name="android:paddingHorizontal">16dp</item>
        <item name="android:minWidth">72dp</item><item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/btn_control_selector</item><item name="backgroundTint">@null</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Hearth.IconControl" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/btn_control_selector</item>
        <item name="backgroundTint">@null</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
