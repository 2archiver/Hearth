    <string name="protocol_airplay">AirPlay</string>
    <!-- iPhone/iPad/Mac screen mirroring. Hearth's second Home card: same AirPlay
         receiver as the first, reported from the video stream instead of the session. -->
    <string name="protocol_apple_casting">Apple Casting</string>

    <!-- ── Protocol states (shown in status cards) ─────────────── -->
    <string name="protocol_state_disabled">Disabled</string>
    <string name="protocol_state_advertising">Ready to connect</string>
    <string name="protocol_state_connected">Connected</string>
