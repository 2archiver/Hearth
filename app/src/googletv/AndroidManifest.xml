<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!--
        Opt OUT of Cast SDK's automatic initialization on app start.

        The Cast Connect SDK normally self-initializes via the RECEIVER_OPTIONS_PROVIDER_CLASS_NAME
        meta-data the moment the process is created — before PhairPlayService ever decides whether
        Cast is enabled — which binds TCP 8008/8009 (Cast receiver web server) regardless of user
        settings. That:
          1. Wastes ports even with Cast disabled (visible in netstat as LISTEN on 8008/8009).
          2. Clashes with mDNS / other receivers the user may have running.
          3. Fires up the Cast receiver SDK even when the user has toggled Cast off in Settings.

        PhairPlay explicitly calls CastReceiverContext.initInstance() + .start() from
        CastReceiver.start() only after verifying an App ID is configured AND the user has Cast
        enabled, so we do not need the automatic initializer.
    -->
    <application
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <!--
            NOTE: the RECEIVER_OPTIONS_PROVIDER_CLASS_NAME entry is INTENTIONALLY OMITTED here
            to prevent auto-init. CastReceiver.start() registers its options provider
            programmatically when needed.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
